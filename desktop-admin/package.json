{
  "name": "quadriamo-admin-desktop",
  "productName": "Quadriamo Admin",
  "version": "1.0.0",
  "description": "Area amministratore di Quadriamo",
  "author": "Quadriamo",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --win --publish never"
  },
  "build": {
    "appId": "app.quadriamo.admin",
    "productName": "Quadriamo Admin",
    "copyright": "© 2026 Quadriamo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Quadriamo-Admin-Mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Quadriamo Admin",
      "icon": "build/icon.png",
      "iconSize": 112,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 230,
          "type": "file"
        },
        {
          "x": 480,
          "y": 230,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Quadriamo Admin",
      "installerLanguages": [
        "it_IT",
        "en_US"
      ],
      "language": "1040",
      "artifactName": "Quadriamo-Admin-Windows-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
